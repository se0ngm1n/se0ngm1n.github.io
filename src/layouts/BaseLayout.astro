---
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Seongmin Lee portfolio and CV',
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <SiteHeader />
    <slot />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    color-scheme: light;
    --bg: #ffffff;
    --panel: #ffffff;
    --panel-2: #f7f7f7;
    --line: #d8d8d8;
    --line-strong: #111111;
    --text: #111111;
    --muted: #555555;
    --soft: #777777;
    --accent: #111111;
    --accent-2: #111111;
    --success: #111111;
    --max: 1120px;
  }

  html {
    min-width: 320px;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family:
      "Helvetica Neue", Arial, Pretendard, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    line-height: 1.5;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
  }

  button,
  input,
  textarea {
    font: inherit;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .site-header__inner,
  .page-shell,
  .cv-shell {
    width: min(var(--max), calc(100% - 48px));
    margin: 0 auto;
  }

  .site-header__inner {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .site-logo {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 22px;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .site-nav a {
    padding: 8px 0;
    border-bottom: 1px solid transparent;
  }

  .site-nav a:hover,
  .site-nav a.active {
    color: var(--text);
    border-color: var(--accent);
  }

  .page-shell {
    padding: 56px 0 80px;
  }

  .page-kicker {
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.16;
    letter-spacing: 0;
  }

  .page-intro {
    max-width: 720px;
    color: var(--muted);
    margin-top: 14px;
    word-break: keep-all;
  }

  .section-card,
  .archive-card,
  .detail-card,
  .profile-panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .section-title {
    color: var(--text);
    font-size: 1.03rem;
    letter-spacing: 0;
    margin-bottom: 16px;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 4px 9px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: #ffffff;
    color: #111111;
    font-size: 0.78rem;
    line-height: 1.2;
  }

  .button-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid var(--line-strong);
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .button-link:hover {
    border-color: var(--line-strong);
    color: var(--accent-2);
  }

  .archive-grid {
    display: grid;
    gap: 14px;
    margin-top: 32px;
  }

  .archive-card {
    display: grid;
    gap: 12px;
    padding: 22px;
    transition:
      border-color 0.18s ease,
      transform 0.18s ease;
  }

  .archive-card:hover {
    transform: translateY(-2px);
    border-color: var(--line-strong);
  }

  .archive-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    color: var(--soft);
    font-size: 0.82rem;
  }

  .archive-meta strong {
    color: var(--accent);
  }

  .archive-card h2,
  .archive-card h3 {
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.3;
    letter-spacing: 0;
    word-break: keep-all;
  }

  .archive-card p {
    color: var(--muted);
    font-size: 0.94rem;
    word-break: keep-all;
  }

  .detail-card {
    margin-top: 30px;
    padding: clamp(22px, 4vw, 38px);
  }

  .detail-content {
    color: var(--text);
    word-break: keep-all;
  }

  .detail-content h2,
  .detail-content h3,
  .detail-content h4 {
    color: var(--text);
    margin: 30px 0 10px;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .detail-content p,
  .detail-content li {
    color: var(--text);
    line-height: 1.78;
  }

  .detail-content p + p,
  .detail-content ul,
  .detail-content ol,
  .detail-content table,
  .detail-content pre {
    margin-top: 14px;
  }

  .detail-content ul,
  .detail-content ol {
    padding-left: 22px;
  }

  .detail-content a {
    color: var(--accent-2);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .detail-content img,
  .detail-content video {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 18px auto;
    border-radius: 8px;
    border: 1px solid var(--line);
  }

  .detail-content pre {
    overflow-x: auto;
    padding: 16px;
    border-radius: 6px;
    background: #f7f7f7;
    border: 1px solid var(--line);
  }

  .detail-content code {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.9em;
  }

  .detail-content table {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .detail-content th,
  .detail-content td {
    border: 1px solid var(--line);
    padding: 9px 11px;
    min-width: 130px;
    text-align: left;
  }

  .detail-content th {
    background: #f7f7f7;
    color: var(--text);
  }

  .empty-state {
    margin-top: 28px;
    padding: 28px;
    border-radius: 6px;
    border: 1px dashed var(--line-strong);
    color: var(--muted);
    word-break: keep-all;
  }

  .site-footer {
    width: min(var(--max), calc(100% - 48px));
    margin: 0 auto;
    padding: 24px 0 34px;
    color: var(--soft);
    font-size: 0.88rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 760px) {
    .site-header__inner,
    .page-shell,
    .cv-shell,
    .site-footer {
      width: min(100% - 32px, var(--max));
    }

    .site-header__inner {
      min-height: 58px;
      align-items: flex-start;
      flex-direction: column;
      padding: 12px 0;
      gap: 8px;
    }

    .site-nav {
      width: 100%;
      gap: 14px;
      overflow-x: auto;
      padding-bottom: 2px;
      font-size: 0.9rem;
    }

    .page-shell {
      padding: 38px 0 64px;
    }

    .archive-card,
    .detail-card {
      padding: 18px;
    }
  }
</style>
