---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';

const hasResume = profile.resume.available && profile.resume.href;
---

<BaseLayout
  title="이성민 | CV"
  description="이성민의 개인 포트폴리오 및 온라인 CV"
>
  <main class="cv-shell">
    <section class="cv-grid" aria-label="Seongmin Lee CV overview">
      <aside class="profile-panel profile-card">
        <div class="portrait" aria-label="Profile photo">
          {profile.image?.src ? (
            <img src={profile.image.src} alt={profile.image.alt} />
          ) : (
            <span>SM</span>
          )}
        </div>

        <div class="identity">
          <h1>{profile.name}</h1>
          <p>{profile.englishName}</p>
        </div>

        <p class="role">{profile.role}</p>

        <dl class="contact-list">
          <div>
            <dt>Affiliation</dt>
            <dd>{profile.university}</dd>
          </div>
          <div>
            <dt>Location</dt>
            <dd>{profile.location}</dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd>
              {profile.email.includes('*') ? (
                <span>{profile.email}</span>
              ) : (
                <a href={`mailto:${profile.email}`}>{profile.email}</a>
              )}
            </dd>
          </div>
          {profile.showPhone && (
            <div>
              <dt>Phone</dt>
              <dd>
                <a href={`tel:${profile.phone.replaceAll(' ', '')}`}>{profile.phone}</a>
              </dd>
            </div>
          )}
          <div>
            <dt>GitHub</dt>
            <dd>
              <a href={profile.github} target="_blank" rel="noopener noreferrer">
                github.com/se0ngm1n
              </a>
            </dd>
          </div>
        </dl>

        <div class="resume-box">
          {hasResume ? (
            <a class="button-link" href={profile.resume.href} download>Download Resume PDF</a>
          ) : (
            <span>Resume will be added soon</span>
          )}
        </div>
      </aside>

      <div class="cv-main">
        <section class="section-card info-section">
          <h2 class="section-title">Education</h2>
          <div class="education-block">
            <strong>{profile.education.school}</strong>
            <span>{profile.education.major}</span>
            <p>{profile.education.degree} | {profile.education.period}</p>
          </div>
        </section>

        <section class="section-card info-section">
          <h2 class="section-title">Focus Areas</h2>
          <div class="tag-list">
            {profile.focusAreas.map((area) => <span class="tag">{area}</span>)}
          </div>
        </section>

        <section class="section-card info-section">
          <h2 class="section-title">Awards</h2>
          <ul class="award-list">
            {profile.awards.map((award) => <li>{award}</li>)}
          </ul>
        </section>

        <nav class="nav-card-grid" aria-label="Portfolio sections">
          {profile.navigationCards.map((card) => (
            <a class="nav-card" href={card.href}>
              <span>{card.title}</span>
              <p>{card.description}</p>
              <strong>View</strong>
            </a>
          ))}
        </nav>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .cv-shell {
    min-height: calc(100vh - 64px);
    padding: clamp(26px, 5vw, 54px) 0;
    display: flex;
    align-items: center;
  }

  .cv-grid {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(280px, 350px) 1fr;
    gap: 22px;
    align-items: stretch;
  }

  .profile-card {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .portrait {
    width: 148px;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: var(--panel-2);
    display: grid;
    place-items: center;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait span {
    color: var(--accent);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .identity h1 {
    font-size: clamp(2rem, 4vw, 2.7rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .identity p,
  .role,
  .contact-list dt,
  .resume-box {
    color: var(--muted);
  }

  .role {
    font-size: 0.96rem;
    word-break: keep-all;
  }

  .contact-list {
    display: grid;
    gap: 12px;
  }

  .contact-list div {
    display: grid;
    gap: 2px;
  }

  .contact-list dt {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-list dd {
    color: var(--text);
    font-size: 0.95rem;
    word-break: break-word;
  }

  .contact-list a:hover {
    color: var(--accent-2);
  }

  .resume-box {
    margin-top: auto;
    min-height: 40px;
    display: flex;
    align-items: center;
    font-size: 0.9rem;
  }

  .cv-main {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 14px;
  }

  .info-section {
    padding: 22px;
  }

  .info-section:first-child {
    grid-column: 1 / -1;
  }

  .education-block {
    display: grid;
    gap: 4px;
    word-break: keep-all;
  }

  .education-block strong {
    font-size: 1.28rem;
    letter-spacing: -0.02em;
  }

  .education-block span,
  .education-block p {
    color: var(--muted);
  }

  .award-list {
    display: grid;
    gap: 9px;
    padding-left: 18px;
    color: #c8d2df;
    font-size: 0.92rem;
    word-break: keep-all;
  }

  .nav-card-grid {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .nav-card {
    min-height: 126px;
    padding: 18px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--panel);
    display: grid;
    gap: 8px;
    align-content: start;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease;
  }

  .nav-card:hover {
    transform: translateY(-2px);
    border-color: rgba(98, 196, 255, 0.38);
  }

  .nav-card span {
    color: var(--text);
    font-size: 1.02rem;
    font-weight: 800;
  }

  .nav-card p {
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .nav-card strong {
    color: var(--accent-2);
    font-size: 0.82rem;
  }

  @media (max-width: 900px) {
    .cv-shell {
      display: block;
      min-height: auto;
    }

    .cv-grid,
    .cv-main,
    .nav-card-grid {
      grid-template-columns: 1fr;
    }

    .portrait {
      width: 132px;
    }
  }

  @media (max-width: 540px) {
    .profile-card,
    .info-section,
    .nav-card {
      padding: 18px;
    }
  }
</style>
