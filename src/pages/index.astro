---
import BaseLayout from '../layouts/BaseLayout.astro';
import FocusAreas from '../components/FocusAreas.astro';
import { profile } from '../data/profile';

const hasResume = profile.resume.available && profile.resume.href;
const roleLines = profile.role.split(' · ');
---

<BaseLayout
  title="이성민 | CV"
  description="이성민의 개인 포트폴리오 및 온라인 CV"
>
  <main class="cv-shell">
    <p class="home-quote">생각하는대로 살지 않으면 사는대로 생각하게 된다.</p>

    <section class="cv-grid" aria-label="Seongmin Lee CV overview">
      <aside class="profile-panel profile-card">
        <div class="portrait" aria-label="Profile image placeholder">
          {profile.image?.src ? (
            <img src={profile.image.src} alt={profile.image.alt} />
          ) : (
            <span aria-hidden="true"></span>
          )}
        </div>

        <div class="identity">
          <h1>{profile.name}</h1>
          <p>{profile.englishName}</p>
        </div>

        <p class="role">
          {roleLines.map((line) => <span>{line}</span>)}
        </p>

        <dl class="contact-list">
          <div>
            <dt>Affiliation</dt>
            <dd>{profile.university}</dd>
          </div>
          <div>
            <dt>Location</dt>
            <dd>{profile.location}</dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd>
              {profile.email.includes('*') ? (
                <span>{profile.email}</span>
              ) : (
                <a href={`mailto:${profile.email}`}>{profile.email}</a>
              )}
            </dd>
          </div>
          {profile.showPhone && (
            <div>
              <dt>Phone</dt>
              <dd>
                <a href={`tel:${profile.phone.replaceAll(' ', '')}`}>{profile.phone}</a>
              </dd>
            </div>
          )}
        </dl>

        {hasResume && (
          <div class="resume-box">
            <a class="button-link" href={profile.resume.href} download>Download Resume PDF</a>
          </div>
        )}
      </aside>

      <div class="cv-main">
        <section class="section-card info-section">
          <h2 class="section-title">Education</h2>
          <div class="education-block">
            <strong>{profile.education.school}</strong>
            <span>{profile.education.major}</span>
            <p>{profile.education.degree} | {profile.education.period}</p>
          </div>
          <div class="training-block">
            <h3>Ongoing Training</h3>
            <ul class="training-list">
              {profile.training.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </section>

        <section class="section-card info-section">
          <h2 class="section-title">Awards</h2>
          <ul class="award-list">
            {profile.awards.map((award) => <li>{award}</li>)}
          </ul>
        </section>

        <section class="section-card info-section">
          <h2 class="section-title">Focus Areas</h2>
          <FocusAreas areas={profile.focusAreas} />
        </section>

        <nav class="nav-card-grid" aria-label="Portfolio sections">
          {profile.navigationCards.map((card) => (
            <a class="nav-card" href={card.href}>
              <span>{card.title}</span>
              <svg class="nav-card__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h12" />
                <path d="M13 6l6 6-6 6" />
              </svg>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <footer class="home-footer" aria-label="Homepage footer">
      <p>© 2025 se0ngm1n. 일부 권리 보유.</p>
      <p class="home-footer__mark">071128</p>
    </footer>
  </main>
</BaseLayout>

<style>
  .cv-shell {
    position: relative;
    min-height: calc(100vh - 64px);
    padding: clamp(18px, 3vw, 36px) 0 clamp(28px, 5vw, 58px);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 20px;
  }

  .home-quote {
    position: absolute;
    top: calc(clamp(18px, 3vw, 36px) / 2);
    right: 0;
    transform: translateY(-50%);
    color: var(--soft);
    font-size: 0.78rem;
    line-height: 1.5;
    text-align: right;
    word-break: keep-all;
  }

  .cv-grid {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(280px, 330px) 1fr;
    gap: 24px;
    align-items: stretch;
  }

  .profile-card {
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .portrait {
    width: 132px;
    aspect-ratio: 1;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: var(--panel-2);
    display: grid;
    place-items: center;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait span {
    display: block;
    width: 100%;
    height: 100%;
  }

  .identity h1 {
    font-size: clamp(2rem, 4vw, 2.7rem);
    line-height: 1.05;
    letter-spacing: 0;
  }

  .identity p,
  .role,
  .resume-box {
    color: var(--muted);
  }

  .role {
    display: grid;
    gap: 2px;
    font-size: 0.98rem;
    word-break: keep-all;
  }

  .contact-list {
    margin-top: 24px;
    display: grid;
    gap: 16px;
  }

  .contact-list div {
    display: grid;
    gap: 4px;
  }

  .contact-list dt {
    color: var(--text);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .contact-list dd {
    color: var(--text);
    font-size: 0.95rem;
    word-break: break-word;
  }

  .contact-list a:hover {
    color: var(--accent-2);
  }

  .resume-box {
    margin-top: auto;
    min-height: 40px;
    display: flex;
    align-items: center;
    font-size: 0.9rem;
  }

  .cv-main {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .info-section {
    padding: 22px 24px;
  }

  .info-section .section-title {
    font-size: 1.12rem;
  }

  .education-block {
    display: grid;
    gap: 4px;
    word-break: keep-all;
  }

  .education-block strong {
    font-size: 1.28rem;
    letter-spacing: 0;
  }

  .education-block span,
  .education-block p {
    color: var(--muted);
  }

  .training-block {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 8px;
  }

  .training-block h3 {
    color: var(--text);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .training-list {
    display: grid;
    gap: 6px;
    padding-left: 18px;
    color: var(--text);
    font-size: 0.9rem;
    word-break: keep-all;
  }

  .award-list {
    display: grid;
    gap: 8px;
    padding-left: 18px;
    color: var(--text);
    font-size: 0.92rem;
    word-break: keep-all;
  }

  .nav-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .nav-card {
    min-height: 46px;
    padding: 12px 18px;
    border-radius: 6px;
    border: 1px solid #111111;
    background: #111111;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition:
      transform 0.18s ease,
      background 0.18s ease,
      color 0.18s ease;
  }

  .nav-card:hover {
    transform: translateY(-2px);
    background: #ffffff;
    color: #111111;
  }

  .nav-card span {
    color: inherit;
    font-size: 1.02rem;
    font-weight: 800;
  }

  .nav-card__icon {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.92;
  }

  .home-footer {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    color: var(--soft);
    font-size: 0.74rem;
    line-height: 1.45;
  }

  .home-footer__mark {
    text-align: right;
  }

  @media (max-width: 900px) {
    .cv-shell {
      display: block;
      min-height: auto;
    }

    .home-quote {
      position: static;
      transform: none;
      margin-bottom: 14px;
    }

    .cv-grid,
    .cv-main,
    .nav-card-grid {
      grid-template-columns: 1fr;
    }

    .portrait {
      width: 132px;
    }

    .home-footer {
      margin-top: 24px;
    }
  }

  @media (max-width: 540px) {
    .profile-card,
    .info-section,
    .nav-card {
      padding: 18px;
    }

    .home-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .home-quote,
    .home-footer__mark {
      text-align: left;
    }
  }
</style>
