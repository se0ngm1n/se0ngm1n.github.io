---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const toDateKey = (date: string | Date) =>
  date instanceof Date ? date.toISOString().slice(0, 10) : date;

const formatDate = (date: string | Date) => toDateKey(date).replaceAll('-', '.');
const lifeContentModules = import.meta.glob('../../content/life/**/*.md');

const posts = (
  Object.keys(lifeContentModules).length > 0 ? await getCollection('life') : []
).sort((a, b) =>
  toDateKey(b.data.date).localeCompare(toDateKey(a.data.date)),
);
---

<BaseLayout
  title="Life | 이성민"
  description="하이킹, 백패킹, 캠핑, 주짓수 등 일상 기록"
>
  <main class="page-shell life-page">
    <p class="page-kicker">Personal Archive</p>
    <h1 class="page-title">Life</h1>
    <p class="page-intro">
      백패킹, 캠핑, 필름 사진과 일상 기록을 사진과 짧은 글로 남기는 개인
      아카이브입니다.
    </p>

    {posts.length > 0 ? (
      <section class="life-grid" aria-label="Life posts">
        {posts.map((post) => (
          <a class="archive-card life-card" href={`/life/${post.id}/`}>
            <div class="life-cover">
              {post.data.cover ? (
                <img src={post.data.cover} alt="" loading="lazy" />
              ) : (
                <span>{post.data.category}</span>
              )}
            </div>

            <div class="life-copy">
              <div class="archive-meta">
                <time datetime={toDateKey(post.data.date)}>{formatDate(post.data.date)}</time>
                <strong>{post.data.category}</strong>
              </div>
              <h2>{post.data.title}</h2>
              {post.data.summary && <p>{post.data.summary}</p>}
              <span class="read-more">Read post</span>
            </div>
          </a>
        ))}
      </section>
    ) : (
      <div class="empty-state">
        아직 게시물이 없습니다. 사진과 함께 Markdown 파일을 추가하면 이 페이지에 자동으로 표시됩니다.
      </div>
    )}
  </main>
</BaseLayout>

<style>
  .life-page {
    --accent: #111111;
    --accent-2: #111111;
  }

  .life-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 32px;
  }

  .life-card {
    grid-template-columns: minmax(150px, 0.38fr) 1fr;
    padding: 0;
    overflow: hidden;
  }

  .life-cover {
    min-height: 190px;
    background: var(--panel-2);
    display: grid;
    place-items: center;
    border-right: 1px solid var(--line);
  }

  .life-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .life-cover span {
    color: var(--accent-2);
    font-weight: 800;
  }

  .life-copy {
    padding: 22px;
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .read-more {
    color: var(--accent-2);
    font-size: 0.88rem;
    font-weight: 800;
  }

  @media (max-width: 860px) {
    .life-grid,
    .life-card {
      grid-template-columns: 1fr;
    }

    .life-cover {
      min-height: 210px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
