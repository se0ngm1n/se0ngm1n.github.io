---
import studyData from '../data/study-posts.json';

const posts = studyData.posts;
const formatDate = (date) => date.replaceAll('-', '.');
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Study | 이성민 Robotics Portfolio</title>
    <meta
      name="description"
      content="Unitree Go2 Sim2Real, Isaac Lab, Isaac Sim, Reinforcement Learning 스터디 글 모음"
    />
    <script is:inline>
      window.MathJax = {
        tex: {
          inlineMath: [
            ['$', '$'],
            ['\\(', '\\)'],
          ],
        },
      };
    </script>
    <script async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"></script>
  </head>

  <body>
    <header class="header">
      <div class="container nav">
        <a class="logo" href="/">SEONGMIN.</a>

        <nav>
          <a href="/#projects">Projects</a>
          <a class="active" href="/study/">Study</a>
          <a href="/#about">About</a>
          <a href="/#skills">Skills</a>
          <a href="https://github.com/se0ngm1n" target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <main>
      <section class="study-hero container">
        <p class="label">TECHNICAL NOTES</p>
        <h1>Study Archive</h1>
        <p class="intro">
          로보틱스, Sim2Real, 강화학습 기록을 포스팅 형태로 모았습니다.
        </p>

        <div class="study-summary" aria-label="스터디 글 통계">
          <span>{posts.length} posts</span>
          <span>Robotics · Sim2Real · RL</span>
        </div>
      </section>

      <section class="feed-section">
        <div class="container feed">
          <div class="post-stack">
            {posts.map((post) => (
              <article class="study-post" id={post.slug}>
                <div class="post-header">
                  <div class="post-image-fallback">{post.categories[0]}</div>

                  <div class="post-heading">
                    <div class="post-meta">
                      <time>{formatDate(post.date)}</time>
                      <span>{post.categories.join(' · ')}</span>
                    </div>
                    <h3>{post.title}</h3>
                    <p>{post.summary}</p>
                  </div>
                </div>

                <details class="post-body">
                  <summary>본문 보기</summary>
                  <div class="post-content" set:html={post.contentHtml} />
                </details>
              </article>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <p>© 2026 Seongmin Lee. All rights reserved.</p>
        <a href="/">Back to portfolio</a>
      </div>
    </footer>

    <script is:inline>
      const openCurrentPost = () => {
        const id = decodeURIComponent(window.location.hash.slice(1));
        if (!id) return;

        const target = document.getElementById(id);
        const details = target?.querySelector('details');

        if (details) {
          details.open = true;
        }
      };

      window.addEventListener('hashchange', openCurrentPost);
      openCurrentPost();
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    background: #0c1017;
    color: #f4f7fb;
    font-family:
      Inter, Pretendard, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    line-height: 1.6;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .container {
    width: min(1160px, calc(100% - 48px));
    margin: 0 auto;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(12, 16, 23, 0.82);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .nav {
    height: 72px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  nav {
    display: flex;
    gap: 28px;
    color: #aeb8c8;
    font-size: 0.95rem;
  }

  nav a:hover,
  nav a.active {
    color: #ffffff;
  }

  .study-hero {
    padding: 88px 0 58px;
  }

  .label {
    color: #55c6ff;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    margin-bottom: 16px;
  }

  h1 {
    font-size: clamp(2.6rem, 5vw, 4.3rem);
    line-height: 1.1;
    letter-spacing: -0.06em;
    margin-bottom: 22px;
  }

  .intro {
    max-width: 760px;
    color: #aeb8c8;
    font-size: 1.04rem;
    word-break: keep-all;
  }

  .study-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 34px;
  }

  .study-summary span {
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(85, 198, 255, 0.07);
    color: #c7eaff;
    font-size: 0.86rem;
    padding: 8px 13px;
  }

  .feed-section {
    padding: 74px 0 104px;
    background: #0f141d;
  }

  h2 {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    letter-spacing: -0.05em;
    line-height: 1.25;
  }

  .post-stack {
    display: grid;
    gap: 22px;
  }

  .study-post {
    scroll-margin-top: 150px;
    border-radius: 22px;
    background: #151c27;
    border: 1px solid rgba(255, 255, 255, 0.07);
    overflow: hidden;
  }

  .post-header {
    display: grid;
    grid-template-columns: 330px 1fr;
    gap: 0;
  }

  .post-header > img,
  .post-image-fallback {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
    background: #0b1018;
  }

  .post-image-fallback {
    display: grid;
    place-items: center;
    color: #55c6ff;
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .post-heading {
    padding: 30px;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    color: #55c6ff;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 14px;
  }

  .post-meta span {
    color: #8b97a9;
  }

  .post-heading h3 {
    font-size: clamp(1.38rem, 2vw, 1.9rem);
    line-height: 1.25;
    letter-spacing: -0.04em;
    margin-bottom: 14px;
    word-break: keep-all;
  }

  .post-heading p {
    color: #aeb8c8;
    font-size: 0.95rem;
    word-break: keep-all;
  }

  .post-body {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .post-body summary {
    cursor: pointer;
    padding: 18px 30px;
    color: #c7eaff;
    font-weight: 750;
    list-style-position: inside;
  }

  .post-content {
    padding: 10px 30px 38px;
    color: #c8d2df;
    word-break: keep-all;
  }

  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    color: #f4f7fb;
    line-height: 1.35;
    letter-spacing: -0.03em;
    margin: 34px 0 12px;
  }

  .post-content :global(h2) {
    font-size: 1.32rem;
  }

  .post-content :global(h3) {
    font-size: 1.12rem;
  }

  .post-content :global(p),
  .post-content :global(li) {
    color: #c2ccd9;
    font-size: 0.96rem;
    line-height: 1.85;
  }

  .post-content :global(p + p),
  .post-content :global(ul),
  .post-content :global(ol),
  .post-content :global(blockquote),
  .post-content :global(table),
  .post-content :global(pre) {
    margin-top: 16px;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    padding-left: 22px;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid #55c6ff;
    padding: 12px 0 12px 18px;
    background: rgba(85, 198, 255, 0.06);
    border-radius: 0 12px 12px 0;
  }

  .post-content :global(a) {
    color: #76d0ff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-content :global(img),
  .post-content :global(video),
  .post-content :global(iframe) {
    max-width: 100%;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #0b1018;
  }

  .post-content :global(img) {
    display: block;
    height: auto;
    margin: 16px auto;
  }

  .post-content :global(pre) {
    overflow-x: auto;
    padding: 16px;
    border-radius: 14px;
    background: #090d14;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .post-content :global(code) {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.88rem;
  }

  .post-content :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .post-content :global(th),
  .post-content :global(td) {
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 10px 12px;
    min-width: 140px;
    text-align: left;
  }

  .post-content :global(th) {
    color: #f4f7fb;
    background: rgba(255, 255, 255, 0.06);
  }

  .post-content :global(.code-header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    color: #7f8ba0;
    font-size: 0.78rem;
  }

  .post-content :global(.code-header button),
  .post-content :global(.code-header i) {
    display: none;
  }

  .post-content :global(.rouge-table) {
    display: table;
    width: 100%;
    margin: 0;
  }

  .post-content :global(.rouge-table td),
  .post-content :global(.rouge-table th) {
    min-width: 0;
    padding: 0;
    border: 0;
    background: transparent;
    vertical-align: top;
  }

  .post-content :global(.rouge-gutter) {
    width: 38px;
    padding-right: 12px;
    color: #586579;
    user-select: none;
  }

  .post-content :global(.rouge-code) {
    width: 100%;
  }

  .footer {
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    padding: 29px 0;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: #798596;
    font-size: 0.9rem;
  }

  .footer-inner a {
    color: #c7eaff;
  }

  .footer-inner a:hover {
    color: #55c6ff;
  }

  @media (max-width: 920px) {
    .post-header {
      grid-template-columns: 1fr;
    }

    .post-header > img,
    .post-image-fallback {
      aspect-ratio: 16 / 9;
      min-height: 0;
    }

  }

  @media (max-width: 640px) {
    .container {
      width: min(100% - 32px, 1160px);
    }

    .nav {
      height: 64px;
    }

    nav a:not(:last-child) {
      display: none;
    }

    .study-hero {
      padding: 62px 0 44px;
    }

    h1 {
      font-size: 2.45rem;
    }

    .post-heading,
    .post-content {
      padding-left: 22px;
      padding-right: 22px;
    }

    .post-body summary {
      padding-left: 22px;
      padding-right: 22px;
    }

    .footer-inner {
      display: block;
    }

    .footer-inner > a {
      display: block;
      margin-top: 8px;
    }
  }
</style>
