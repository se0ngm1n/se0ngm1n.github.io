---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import studyData from '../../data/study-posts.json';

type DateLike = string | Date;
type StudyListPost = {
  slug: string;
  title: string;
  date: DateLike;
  category: string;
  summary: string;
  tags: string[];
  thumbnail?: {
    src: string;
    alt: string;
  };
};

const toDateKey = (date: DateLike) =>
  date instanceof Date ? date.toISOString().slice(0, 10) : date;

const formatDate = (date: DateLike) => toDateKey(date).replaceAll('-', '.');
const studyContentModules = import.meta.glob('../../content/study/**/*.md');
const thumbnailImageIndexes: Record<string, number> = {
  'isaaclab-part-4-rl-policy-isaac-sim': 2,
  'isaaclab-part-3-rl-training': 8,
  'isaaclab-part-2-environment': 1,
  'isaaclab-part-1-urdf-import': 2,
  'isaac-sim-ros2-joint-control': 1,
  'isaac-sim-publish-rate-qos': 2,
  'isaac-sim-tf-odometry': 1,
  'isaac-sim-rtx-lidar': 1,
  'isaac-sim-ros2-cameras': 3,
  'isaac-sim-turtlebot-ros2': 16,
};

const getImageAttribute = (tag: string, name: string) => {
  const match = tag.match(new RegExp(`${name}=["']([^"']+)["']`, 'i'));
  return match?.[1] ?? '';
};

const getPostThumbnail = (post: (typeof studyData.posts)[number]) => {
  const imageTags = Array.from(post.contentHtml.matchAll(/<img\b[^>]*>/gi));
  const imageIndex = thumbnailImageIndexes[post.slug] ?? 1;
  const imageTag = imageTags[imageIndex - 1] ?? imageTags[0];

  if (!imageTag) return undefined;

  return {
    src: getImageAttribute(imageTag[0], 'src'),
    alt: getImageAttribute(imageTag[0], 'alt') || post.title,
  };
};

const legacyPosts = studyData.posts.map((post) => ({
  slug: post.slug,
  title: post.title,
  date: post.date,
  category: post.categories.join(' · '),
  summary: post.summary,
  tags: post.tags,
  thumbnail: getPostThumbnail(post),
}));

const collectionEntries =
  Object.keys(studyContentModules).length > 0 ? await getCollection('study') : [];

const collectionPosts = collectionEntries.map((post) => ({
  slug: post.id,
  title: post.data.title,
  date: post.data.date,
  category: post.data.category,
  summary: post.data.summary,
  tags: post.data.tags,
  thumbnail: post.data.thumbnail
    ? {
        src: post.data.thumbnail,
        alt: post.data.title,
      }
    : undefined,
}));

const postMap = new Map<string, StudyListPost>();
for (const post of legacyPosts) postMap.set(post.slug, post);
for (const post of collectionPosts) postMap.set(post.slug, post);

const posts = Array.from(postMap.values()).sort(
  (a, b) => toDateKey(b.date).localeCompare(toDateKey(a.date)),
);
---

<BaseLayout
  title="Study | 이성민"
  description="로보틱스, 시뮬레이션, 강화학습, 로봇 제어 기술 노트"
>
  <main class="page-shell">
    <p class="page-kicker">Technical Notes</p>
    <h1 class="page-title">Study</h1>
    <p class="page-intro">
      시뮬레이션, 강화학습, 로봇 제어, 개발 환경 구축 과정 정리 노트입니다
    </p>

    {posts.length > 0 ? (
      <section class="archive-grid" aria-label="Study posts">
        {posts.map((post) => (
          <a class:list={['archive-card', 'study-card', { 'study-card--plain': !post.thumbnail }]} href={`/study/${post.slug}/`}>
            {post.thumbnail && (
              <img class="study-card__thumbnail" src={post.thumbnail.src} alt={post.thumbnail.alt} loading="lazy" />
            )}
            <div class="study-card__body">
              <div class="archive-meta">
                <time datetime={toDateKey(post.date)}>{formatDate(post.date)}</time>
                <strong>{post.category}</strong>
              </div>
              <h2>{post.title}</h2>
              <p>{post.summary}</p>
              <div class="tag-list" aria-label="Tags">
                {post.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
              <span class="read-more">Read post</span>
            </div>
          </a>
        ))}
      </section>
    ) : (
      <div class="empty-state">
        아직 게시물이 없습니다. Markdown 파일을 추가하면 이 페이지에 자동으로 표시됩니다.
      </div>
    )}
  </main>
</BaseLayout>

<style>
  .study-card {
    grid-template-columns: 118px minmax(0, 1fr);
    align-items: center;
  }

  .study-card--plain {
    grid-template-columns: 1fr;
  }

  .study-card__thumbnail {
    width: 118px;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: 4px;
    object-fit: cover;
    background: #f4f4f4;
  }

  .study-card__body {
    min-width: 0;
    display: grid;
    gap: 12px;
  }

  .read-more {
    color: var(--accent-2);
    font-size: 0.88rem;
    font-weight: 800;
  }

  @media (max-width: 640px) {
    .study-card {
      grid-template-columns: 88px minmax(0, 1fr);
      align-items: start;
    }

    .study-card__thumbnail {
      width: 88px;
    }
  }
</style>
