---
interface Props {
  areas: string[];
}

const { areas } = Astro.props;
---

<div class="focus-area-list">
  {areas.map((area) => (
    <span class="focus-area-chip" tabindex="0">
      <span class="focus-area-chip__label">{area}</span>
    </span>
  ))}
</div>

<style>
  .focus-area-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    overflow: visible;
  }

  .focus-area-chip {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid #111111;
    background: #ffffff;
    color: #111111;
    font-size: 0.78rem;
    line-height: 1.2;
    cursor: default;
    outline: none;
    transition:
      background 0.16s ease,
      border-color 0.16s ease,
      color 0.16s ease;
  }

  .focus-area-chip:hover,
  .focus-area-chip:focus-visible {
    background: #eeeeee;
    border-color: #777777;
  }

</style>
