---
interface Props {
  areas: string[];
}

const { areas } = Astro.props;
---

<div class="focus-area-list">
  {areas.map((area) => (
    <span class="focus-area-chip" tabindex="0">
      <span class="focus-area-chip__label">{area}</span>
    </span>
  ))}
</div>

<style>
  .focus-area-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    overflow: visible;
  }

  .focus-area-chip {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid #111111;
    background: #ffffff;
    color: #111111;
    font-size: 0.78rem;
    line-height: 1.2;
    cursor: default;
    outline: none;
    overflow: hidden;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .focus-area-chip::before,
  .focus-area-chip::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    content: "";
    opacity: 0;
    pointer-events: none;
  }

  .focus-area-chip::before {
    z-index: 0;
    background:
      radial-gradient(circle at 18% 30%, rgba(120, 200, 255, 0.72), transparent 32%),
      radial-gradient(circle at 82% 70%, rgba(174, 229, 255, 0.7), transparent 34%),
      linear-gradient(135deg, rgba(238, 249, 255, 0.96), rgba(196, 232, 255, 0.9));
    transform: scale(1.02);
  }

  .focus-area-chip::after {
    z-index: 1;
    background:
      linear-gradient(95deg, transparent 0 20%, rgba(255, 255, 255, 0.82) 32%, transparent 48%),
      repeating-radial-gradient(
        ellipse at 50% 110%,
        rgba(53, 145, 213, 0.26) 0 2px,
        transparent 2px 9px
      );
    background-size: 220% 100%, 120% 120%;
  }

  .focus-area-chip__label {
    position: relative;
    z-index: 2;
  }

  .focus-area-chip:hover,
  .focus-area-chip:focus-visible {
    background: #eaf7ff;
    border-color: #6bb8ee;
    box-shadow: 0 8px 22px rgba(80, 160, 215, 0.18);
    transform: translateY(-1px);
  }

  .focus-area-chip:hover::before,
  .focus-area-chip:hover::after,
  .focus-area-chip:focus-visible::before,
  .focus-area-chip:focus-visible::after {
    opacity: 1;
  }

  .focus-area-chip:hover::before,
  .focus-area-chip:focus-visible::before {
    animation: focus-water-swell 2.2s ease-in-out infinite;
  }

  .focus-area-chip:hover::after,
  .focus-area-chip:focus-visible::after {
    animation: focus-water-glint 1.8s linear infinite;
  }

  @keyframes focus-water-swell {
    0%,
    100% {
      transform: scale(0.98) translateY(0);
      filter: hue-rotate(0deg);
    }

    45% {
      transform: scale(1.04) translateY(-1px);
      filter: hue-rotate(8deg);
    }

    70% {
      transform: scale(1.01) translateY(1px);
    }
  }

  @keyframes focus-water-glint {
    0% {
      background-position: 140% 0, 0 0;
    }

    100% {
      background-position: -80% 0, 28px -16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .focus-area-chip:hover::before,
    .focus-area-chip:hover::after,
    .focus-area-chip:focus-visible::before,
    .focus-area-chip:focus-visible::after {
      animation: none;
    }
  }

</style>
